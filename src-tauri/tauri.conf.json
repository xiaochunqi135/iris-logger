{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iris-logger",
  "version": "0.1.1",
  "identifier": "com.arco.iris-logger",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "deno task build",
    "beforeBuildCommand": "deno task build"
  },
  "app": {
    "windows": [
      {
        "title": "iris-logger",
        "width": 640,
        "height": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 24
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:data.db"]
    }
  }
}
